# Copy this file to .env.local for local development (vercel dev reads it automatically).
# Never commit .env.local — it's already in .gitignore.

# Finnhub API key (free tier). Get one at https://finnhub.io/register
FINNHUB_API_KEY=

# Anthropic API key, used to generate each pod's daily sector brief.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GitHub personal access token used by /api/update-market-pulse to commit
# data/market-pulse.json, data/watchlist-quotes.json, and each pod's updated
# content file back to this repo. See README.md for how to create one.
GITHUB_TOKEN=

# "owner/repo-name", e.g. "your-github-username/nerc-pod-website"
GITHUB_REPO=

# Branch to commit to. Defaults to "main" if omitted.
GITHUB_BRANCH=main
