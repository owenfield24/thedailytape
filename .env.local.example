# Copy this file to .env.local for local development (vercel dev reads it automatically).
# Never commit .env.local — it's already in .gitignore.

# Finnhub API key (free tier). Get one at https://finnhub.io/register
# Used for equity/ETF quotes (SPY/DIA/QQQ index proxies, watchlist tickers)
# and news headlines. NOT used for the 10-year Treasury yield — see FRED below.
FINNHUB_API_KEY=

# FRED (Federal Reserve Economic Data) API key — free, instant, self-service.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
# Used for the real 10-year Treasury yield (Finnhub's free tier doesn't
# expose real yield/index data at all — see api/lib/market-data-finnhub.js).
FRED_API_KEY=

# Anthropic API key, used to generate each pod's daily sector brief.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GitHub personal access token used by /api/update-market-pulse to commit
# data/market-pulse.json, data/watchlist-quotes.json, and each pod's updated
# content file back to this repo. See README.md for how to create one.
GITHUB_TOKEN=

# "owner/repo-name", e.g. "your-github-username/nerc-pod-website"
GITHUB_REPO=

# Branch to commit to. Defaults to "main" if omitted.
GITHUB_BRANCH=main

# Resend API key, used to actually send subscriber emails (Today's Brief and
# each pod's brief). Free tier: 3,000 emails/month. Get one at
# https://resend.com/api-keys (create it with "Sending access" only).
RESEND_API_KEY=

# Optional: "Name <verified@yourdomain.com>". Defaults to Resend's shared
# onboarding@resend.dev sender, which can only deliver to YOUR OWN verified
# address until you verify a real sending domain in the Resend dashboard —
# see README.md's "Getting a Resend API key" section before expecting real
# subscribers to receive mail.
RESEND_FROM_ADDRESS=

# Fine-grained GitHub PAT scoped to a SEPARATE, PRIVATE repo used only to
# store email subscribers (see api/lib/subscribers-store.js) — subscriber
# emails can't live in this site's public repo. Needs Contents: Read/write
# on that private repo only.
SUBSCRIBERS_GITHUB_TOKEN=

# "owner/repo-name" of that private repo, e.g. "your-github-username/thedailytape-subscribers"
SUBSCRIBERS_GITHUB_REPO=

# Branch to commit subscribers.json to in that repo. Defaults to "main".
SUBSCRIBERS_GITHUB_BRANCH=main

# This site's own public URL, used to build the unsubscribe link in every
# email (e.g. "https://thedailytape.vercel.app", no trailing slash).
SITE_URL=
